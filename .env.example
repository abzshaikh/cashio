# Copy this file to .env and fill in your Firebase project's web app config
# (Firebase Console > Project settings > General > Your apps).
# These values are safe to expose client-side — Firestore/Auth access is
# controlled by security rules, not by keeping this config secret.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
